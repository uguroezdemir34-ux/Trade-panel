{
  "name": "ugur-trade-panel",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Uğur Trader Panel v2 — v55.51 panelinin Next.js mimarisine taşınmış hali. BTC + ETH futures, disiplinli kural tabanlı sinyal motoru.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "analyze": "ANALYZE=true next build",
    "perf:check": "tsx scripts/bundle-budget.ts",
    "smoke": "tsx scripts/smoke-prod.ts",
    "quantix:install": "node scripts/quantix-install.mjs",
    "quantix:check-env": "node -e \"const fs=require('fs');const ex=fs.readFileSync('.env.example','utf8');const vars=ex.match(/^[A-Z_]+=.*/gm)?.map(l=>l.split('=')[0])||[];const env=fs.existsSync('.env.local')?fs.readFileSync('.env.local','utf8'):'';let ok=true;vars.forEach(v=>{if(!env.includes(v+'=')){console.warn('[QUANTIX] EKSIK: '+v);ok=false;}else{console.log('[QUANTIX] OK: '+v);}});if(!ok){console.error('\\n.env.local eksik değişkenler var. cp .env.example .env.local yapın.');process.exit(1);}console.log('\\n[QUANTIX] Tüm env değişkenleri mevcut.');\"",
    "quantix:up": "pnpm quantix:check-env && pnpm build && pnpm start",
    "mobile:sync": "npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "mobile:build": "npm run build && npx cap sync",
    "mobile:icons": "npx @capacitor/assets generate --ios --android --pwa",
    "mobile:add-ios": "npx cap add ios && npx cap sync",
    "mobile:add-android": "npx cap add android && npx cap sync"
  },
  "dependencies": {
    "eruda": "^3.4.1",
    "@capacitor/android": "^7.0.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@napi-rs/canvas": "^0.1.65",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "capacitor-native-purchases": "^0.3.2",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@clerk/nextjs": "6.12.0",
    "@clerk/themes": "^2.1.40",
    "@tanstack/react-query": "5.62.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "clsx": "2.1.1",
    "fast-xml-parser": "^4.5.1",
    "googleapis": "^144.0.0",
    "lightweight-charts": "^4.2.3",
    "next": "^15.5.18",
    "react": "19.0.3",
    "react-dom": "19.0.3",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1",
    "sonner": "^2.0.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.18",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.0",
    "jsdom": "^29.1.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
