# ╔══════════════════════════════════════════════════════════════════╗
# ║           QUANTIX OS — DEPLOYMENT ENVIRONMENT TEMPLATE          ║
# ║                                                                  ║
# ║  Kullanım:                                                       ║
# ║    cp .env.example .env.local                                    ║
# ║    # .env.local'ı doldurun, ardından: pnpm dev                   ║
# ║                                                                  ║
# ║  GÜVENLİK: .env.local GİTİGNORE'DA. Asla commit etmeyin.        ║
# ╚══════════════════════════════════════════════════════════════════╝


# ──────────────────────────────────────────────────────────────────
# UYGULAMA
# ──────────────────────────────────────────────────────────────────

# Uygulamanın dış URL'i (Vercel deploy'da otomatik gelir)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ──────────────────────────────────────────────────────────────────
# CLERK AUTH — Kullanıcı kimlik doğrulama
# Dashboard → https://dashboard.clerk.com
# 1. Yeni uygulama oluştur → API Keys sekmesinden key'leri kopyala
# 2. Vercel'de Environment Variables olarak ekle
# ──────────────────────────────────────────────────────────────────

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Auth sayfası yönlendirmeleri (değiştirme)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# /admin/waitlist sayfasına ve /api/admin/* route'larına erişebilecek Clerk
# userId'leri, virgülle ayrılmış (bkz. lib/auth/admin.ts). Kendi userId'ini
# Clerk Dashboard → Users → (kendi hesabın) → sayfanın en üstündeki
# "user_..." ID'den bulabilirsin.
ADMIN_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────
# SUPABASE — Kalıcı veri tabanı (trade geçmişi, P&L)
# Dashboard → https://supabase.com/dashboard
# 1. Yeni proje oluştur → Project Settings → API
# 2. "Project URL" → SUPABASE_URL
# 3. "service_role" secret → SUPABASE_SERVICE_ROLE_KEY (ASLA browser'a verme)
# 4. SQL Editor'da supabase/migrations/001_create_trades.sql çalıştır
#    (ardından 002, 003, 004_rls_policies.sql, 005_create_stripe_events.sql)
# ──────────────────────────────────────────────────────────────────

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx


# ──────────────────────────────────────────────────────────────────
# STRIPE — Ödeme altyapısı
# Dashboard → https://dashboard.stripe.com
# 1. API keys → Secret key kopyala (sk_live_...)
# 2. Webhooks → endpoint ekle: https://yourdomain.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.deleted,
#    customer.subscription.updated, invoice.payment_failed
# 3. Products → Pro planı oluştur → Price ID kopyala (price_...)
# 4. Webhook signing secret → webhook detail sayfasından (whsec_...)
# ──────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Price ID — Stripe Dashboard'dan Pro plan monthly price ID
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────
# GOOGLE PLAY — Android native abonelik doğrulama (androidpublisher API)
# 1. console.cloud.google.com → proje seç/oluştur → IAM & Admin →
#    Service Accounts → yeni service account oluştur
# 2. Keys sekmesi → Add Key → JSON → indirilen dosyanın TÜM içeriğini
#    (tek satıra sıkıştırmadan, olduğu gibi) bu değişkene yapıştır
# 3. play.google.com/console → Setup → API access → o service account'ı
#    bağla → "View financial data" iznini ver
# ──────────────────────────────────────────────────────────────────

# İndirilen service account JSON key dosyasının TAM içeriği (ham JSON string)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}


# ──────────────────────────────────────────────────────────────────
# UPSTASH REDIS — /api/okx proxy için rate limiting
# Dashboard → https://console.upstash.com
# 1. Yeni Redis database oluştur (herhangi bir bölge, "Global" gerekmez)
# 2. Details sayfasından "REST API" → UPSTASH_REDIS_REST_URL + TOKEN
# Eksikse rate limiting sessizce devre dışı kalır (bkz. lib/rate-limit.ts).
# ──────────────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────
# FIREBASE CLOUD MESSAGING — Capacitor/Android native push
# Firebase Console → https://console.firebase.google.com
# 1. Proje oluştur (veya mevcut projeyi kullan), Android app ekle
#    (applicationId: com.quantixos.trading) → google-services.json indir,
#    android/app/ altına koy (bkz. supabase/migrations/006_push_platform.sql)
# 2. Project Settings → Service Accounts → "Generate new private key" →
#    inen JSON'dan: project_id → FCM_PROJECT_ID, client_email →
#    FCM_CLIENT_EMAIL, private_key → FCM_PRIVATE_KEY (satır sonlarını
#    "\n" olarak escape edin, Vercel'e tek satır string olarak girin)
# Eksikse FCM gönderimi sessizce atlanır (bkz. lib/push/fcm.ts).
# ──────────────────────────────────────────────────────────────────

FCM_PROJECT_ID=quantix-os-xxxxx
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@quantix-os-xxxxx.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"


# ──────────────────────────────────────────────────────────────────
# OKX — CANLI HESAP (LIVE)
# API Management → https://www.okx.com/account/my-api
# İzinler: Read + Trade (IP kısıtlaması önerilir)
# ──────────────────────────────────────────────────────────────────

OKX_API_KEY=your_live_api_key_here
OKX_API_SECRET=your_live_api_secret_here
OKX_API_PASSPHRASE=your_live_api_passphrase_here


# ──────────────────────────────────────────────────────────────────
# OKX — DEMO HESAP (SHADOW / Paper Trading)
# Demo API Management → https://www.okx.com/demo-trading/account/my-api
# EXECUTION_MODE=SHADOW iken bu credentials kullanılır.
# ──────────────────────────────────────────────────────────────────

OKX_DEMO_API_KEY=your_demo_api_key_here
OKX_DEMO_API_SECRET=your_demo_api_secret_here
OKX_DEMO_API_PASSPHRASE=your_demo_api_passphrase_here


# ──────────────────────────────────────────────────────────────────
# BINANCE FUTURES (FAPI) — Alternatif borsa
# API Management → https://www.binance.com/en/my/settings/api-management
# İzinler: Enable Futures (Spot izni GEREKMEZ)
# IP kısıtlaması önerilir.
# UYARI: Binance Futures → Hesap → Pozisyon Modu → Hedge Mode AKTİF olmalı.
# ──────────────────────────────────────────────────────────────────

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here


# ──────────────────────────────────────────────────────────────────
# GATE.IO FUTURES (USDT-M) — Alternatif borsa, salt görüntüleme
# API Management → https://www.gate.io/myaccount/apiv4keys
# İzinler: Futures → Read Only yeterli (Trade izni GEREKMEZ)
# ──────────────────────────────────────────────────────────────────

GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_API_SECRET=your_gateio_api_secret_here


# ──────────────────────────────────────────────────────────────────
# KUCOIN FUTURES (USDT-M) — Alternatif borsa, salt görüntüleme
# API Management → https://www.kucoin.com/account/api
# İzinler: General (Read-only) yeterli — Trade izni GEREKMEZ.
# ──────────────────────────────────────────────────────────────────

KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_API_SECRET=your_kucoin_api_secret_here
KUCOIN_API_PASSPHRASE=your_kucoin_api_passphrase_here


# ──────────────────────────────────────────────────────────────────
# MEXC FUTURES (USDT-M) — Alternatif borsa, salt görüntüleme
# API Management → https://www.mexc.com/user/openapi
# İzinler: Read-only yeterli — Trade izni GEREKMEZ.
# ──────────────────────────────────────────────────────────────────

MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here


# ──────────────────────────────────────────────────────────────────
# KRAKEN FUTURES — Alternatif borsa, salt görüntüleme (DENEYSEL —
# pozisyon büyüklüğü hesabı gerçek bir hesapla doğrulanmadı, bkz.
# lib/kraken/positions.ts KRİTİK DOĞRULANMAMIŞ VARSAYIM yorumu)
# API Management → https://futures.kraken.com/settings/api
# İzinler: Read Only yeterli — Full Access/Trade izni GEREKMEZ.
# ──────────────────────────────────────────────────────────────────

KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here


# ──────────────────────────────────────────────────────────────────
# WEB PUSH (PWA) — VAPID anahtarları
# Üretmek için: node scripts/generate-vapid.mjs
# NEXT_PUBLIC_ — tarayıcıya güvenli (public key sadece)
# ──────────────────────────────────────────────────────────────────

NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY_JWK=replace_with_vapid_private_key_jwk_json
VAPID_SUBJECT=mailto:admin@yourdomain.com


# ──────────────────────────────────────────────────────────────────
# OPERASYOn MODU
# SHADOW → OKX Demo hesabı, gerçek kapital riski yok
# LIVE   → OKX Canlı hesap, gerçek işlem
# ──────────────────────────────────────────────────────────────────

EXECUTION_MODE=SHADOW


# ──────────────────────────────────────────────────────────────────
# STATE ŞİFRELEME ANAHTARI
# AES-256-GCM ile localStorage şifrelemesi için sunucu tarafı anahtar.
# Üretmek için: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────

STATE_ENCRYPTION_KEY=replace_with_output_of__openssl_rand_-base64_32


# ──────────────────────────────────────────────────────────────────
# TELEGRAM BİLDİRİM HATTI
# Bot oluşturma: https://t.me/BotFather → /newbot
# Chat ID: gruba botu ekle, https://api.telegram.org/bot<TOKEN>/getUpdates
# Grup ID'si genellikle "-100" ile başlar.
# ──────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_VIP_CHAT_ID=-1001234567890
# Opsiyonel — tanımsızsa halka açık kart gönderimi sessizce atlanır (VIP
# metin sinyalini etkilemez). Aynı bot iki kanalda da yönetici olmalı.
TELEGRAM_PUBLIC_CHAT_ID=-1009876543210
# Opsiyonel, YUKARIDAKİLERDEN AYRI bir grup/kanal — Pro abonelik satın alan
# kullanıcıya Stripe webhook'unun ürettiği tek kullanımlık davet linkinin
# hedefi (bkz. lib/notify/telegram/vipInvite.ts, app/api/stripe/webhook/
# route.ts → ensureVipInviteLink). Botun bu grupta "Invite Users via Link"
# izniyle yönetici olması gerekir. Tanımsızsa Pro satın alımı yine
# tamamlanır, sadece VIP davet linki üretilmez (webhook başarısız olmaz,
# sessizce atlar — ayarlar sayfasındaki VipInviteCard "hazırlanıyor"
# durumunda kalır).
TELEGRAM_VIP_COMMUNITY_CHAT_ID=-1005555555555


# ──────────────────────────────────────────────────────────────────
# DISCORD BİLDİRİM HATTI (opsiyonel)
# Discord sunucusunda: Sunucu Ayarları → Entegrasyonlar → Webhook
# ──────────────────────────────────────────────────────────────────

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx


# ──────────────────────────────────────────────────────────────────
# ANTHROPIC — "AI'ya Sor" pozisyon durum-kontrolü (app/api/ai/position-check)
# Console → https://console.anthropic.com/settings/keys
# Eksikse buton görünür ama tıklandığında açık bir hata gösterir
# ("şu an analiz yapılamadı, tekrar dene") — crash yok, sadece özellik
# devre dışı kalır (bkz. route.ts'teki not_configured dalı).
# ──────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────
# OKX WEBSOCKET (opsiyonel ince ayar)
# Boş bırakılırsa varsayılanlar kullanılır.
# ──────────────────────────────────────────────────────────────────

# İzlenecek enstrümanlar (virgülle ayrılmış OKX instrument ID)
# OKX_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP

# WebSocket ping aralığı (ms) — varsayılan: 25000
# OKX_PING_INTERVAL_MS=25000
